# Для запуска backend локально без Docker (poetry run uvicorn main:app --reload)
# При запуске через Docker — используй marketplace-stack: make setup && make up
#
# Значения берутся из marketplace-stack/.env.local после make setup
# [REQUIRED] — обязательно заполнить
# [optional] — есть дефолт, можно не менять

# ── App ──────────────────────────────────────────────────────────────────────

APP_ENV=development                   # [optional] development / production
DEBUG=true                            # [optional] режим отладки

# ── Database ─────────────────────────────────────────────────────────────────
# Порты берутся из marketplace-stack .env.local (POSTGRES_PORT)

DB__HOST=localhost                    # [optional]
DB__PORT=5432                         # [optional] внешний порт PostgreSQL из docker
DB__NAME=marketplace_local            # [optional] из marketplace-stack: POSTGRES_DB
DB__USER=                             # [REQUIRED] из marketplace-stack: POSTGRES_USER
DB__PASSWORD=                         # [REQUIRED] из marketplace-stack: POSTGRES_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS__HOST=localhost                  # [optional]
REDIS__PORT=6379                       # [optional] внешний порт Redis из docker

# ── MinIO ─────────────────────────────────────────────────────────────────────

MINIO__ENDPOINT=localhost:9000         # [optional] внешний порт MinIO из docker
MINIO__ACCESS_KEY=                     # [REQUIRED] из marketplace-stack: MINIO_ROOT_USER
MINIO__SECRET_KEY=                     # [REQUIRED] из marketplace-stack: MINIO_ROOT_PASSWORD

# ── Auth ──────────────────────────────────────────────────────────────────────

JWT__SECRET_KEY=                       # [REQUIRED] из marketplace-stack: JWT_SECRET_KEY

# ── Optional ─────────────────────────────────────────────────────────────────
# LOG__LEVEL=DEBUG
# DB__ECHO=true
