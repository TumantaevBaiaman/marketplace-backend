# Только для запуска без Docker: poetry run uvicorn main:app --reload
# При запуске через docker compose — используй marketplace-stack/.env

# Меняется между окружениями
APP_ENV=development
DEBUG=true

# Подключение к БД (localhost + внешний порт docker)
DB__HOST=localhost
DB__PORT=5434
DB__NAME=marketplace_local
DB__USER=               # из docker/secrets/postgres_user.txt
DB__PASSWORD=           # из docker/secrets/postgres_password.txt

# Подключение к Redis
REDIS__HOST=localhost
REDIS__PORT=6380

# Подключение к MinIO
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=      # из docker/secrets/minio_root_user.txt
MINIO__SECRET_KEY=      # из docker/secrets/minio_root_password.txt

# Обязательный секрет — нет дефолта в коде
JWT__SECRET_KEY=        # openssl rand -hex 32

# Опционально — дефолты уже в коде
# LOG__LEVEL=DEBUG
# DB__ECHO=true
